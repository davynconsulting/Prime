# Turns on "Read with Claude" on the claims intake desk (server side only, never sent to the browser)
ANTHROPIC_API_KEY=
# Optional: the model used for reading claim emails (default claude-opus-5-5)
ANTHROPIC_MODEL=

# Optional shared storage for decisions. Vercel's Upstash Redis integration sets these two:
KV_REST_API_URL=
KV_REST_API_TOKEN=
# ...or set a direct Upstash database instead:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
